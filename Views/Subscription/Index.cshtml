@{
    ViewData["Title"] = "Subscribe to Newsletter";
}

<div class="py-5" style="background: var(--cream);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7">
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                    <div class="card-body p-4 p-md-5 text-center">
                        <div class="mx-auto mb-3 rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                            <i class="bi bi-envelope-heart fs-2"></i>
                        </div>

                        <h1 class="h2 fw-bold text-dark mt-2" style="font-family: 'Playfair Display', serif;">
                            Stay Inspired
                        </h1>

                        <p class="text-muted small mb-4">
                            Get curated travel inspiration, secret destination guides, and exclusive early-bird offers delivered directly to your inbox.
                        </p>

                        @if (ViewBag.Message != null)
                        {
                            <div class="alert alert-success rounded-4 p-3 mb-4 shadow-sm">
                                <i class="bi bi-check-circle-fill me-1"></i> @ViewBag.Message
                            </div>
                        }

                        <form asp-controller="Subscription" asp-action="Index" method="post">
                            <div class="mb-3">
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-success"></i></span>
                                    <input type="email" name="email" class="form-control border-start-0" placeholder="Enter your email address" required />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success w-100 rounded-pill py-3 fw-bold shadow-sm">
                                <i class="bi bi-send me-1"></i> Subscribe to Nomadic Newsletter
                            </button>
                        </form>

                        <div class="mt-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-4">
                                ← Back to Home
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
