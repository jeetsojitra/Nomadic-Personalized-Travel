@model Nomadic.Models.Booking
@{
    ViewData["Title"] = "Booking Saved - " + Model.BookingId;
}

<div class="py-5" style="background: var(--cream);">
    <div class="container">
        
        <div class="row justify-content-center mb-5">
            <div class="col-md-8">
                <div class="d-flex justify-content-between position-relative">
                    <div class="position-absolute top-50 start-0 translate-middle-y w-100" style="height: 3px; background: var(--green); z-index: 1;"></div>

                    <div class="position-relative text-center" style="z-index: 2;">
                        <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-1 text-white bg-success fw-bold" style="width: 38px; height: 38px;">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <small class="fw-bold text-success">Select Package</small>
                    </div>

                    <div class="position-relative text-center" style="z-index: 2;">
                        <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-1 text-white bg-success fw-bold" style="width: 38px; height: 38px;">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <small class="fw-bold text-success">Details & Payment</small>
                    </div>

                    <div class="position-relative text-center" style="z-index: 2;">
                        <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-1 text-white bg-success fw-bold" style="width: 38px; height: 38px;">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        <small class="fw-bold text-success">Confirmed</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white text-center p-4 p-md-5">
                    <div class="mx-auto mb-3 rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-check-circle-fill display-5"></i>
                    </div>

                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 mx-auto mb-2 fw-semibold">
                        Demo Booking Saved · Payment Not Processed
                    </span>

                    <h1 class="display-6 fw-bold text-dark mb-2" style="font-family: 'Playfair Display', serif;">
                        Booking Request Saved!
                    </h1>
                    <p class="text-muted mb-4">
                        Thank you, <strong>@Model.CustomerName</strong>. Your booking request has been saved in the Nomadic database.
                    </p>

                    
                    <div class="booking-reference-box">
                        <p class="fw-semibold mb-2">BOOKING REFERENCE ID</p>

                        <span class="booking-reference-id">
                            @Model.BookingId
                        </span>

                        <button type="button" class="copy-button"
                                onclick="copyBookingReference()">
                            <i class="bi bi-clipboard"></i>
                        </button>

                        <p class="text-success mt-2 mb-0">
                            <i class="bi bi-shield-check"></i>
                            Stored in the Nomadic SQL Server database
                        </p>
                    </div>


                    
                    <div class="text-start border rounded-4 p-4 mb-4">
                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2" style="font-family: 'Playfair Display', serif;">
                            <i class="bi bi-receipt text-success me-2"></i> Booking Summary
                        </h5>

                        <div class="row g-3 small">
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Package Name:</span>
                                <strong class="text-dark fs-6">@Model.PackageName</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Destination:</span>
                                <strong class="text-dark fs-6">@Model.Destination</strong>
                            </div>

                            <div class="col-sm-6">
                                <span class="text-muted d-block">Departure / Travel Date:</span>
                                <strong class="text-dark">@Model.TravelDate.ToString("dddd, dd MMMM yyyy")</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Number of Travelers:</span>
                                <strong class="text-dark">@Model.TravelersCount Person@(Model.TravelersCount > 1 ? "s" : "")</strong>
                            </div>

                            <div class="col-sm-6">
                                <span class="text-muted d-block">Primary Contact:</span>
                                <strong class="text-dark">@Model.CustomerName</strong>
                                <small class="text-muted d-block">@Model.CustomerEmail | @Model.CustomerPhone</small>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Billing Address:</span>
                                <strong class="text-dark">@Model.CustomerAddress</strong>
                            </div>

                            <div class="col-sm-6">
                                <span class="text-muted d-block">Payment Mode:</span>
                                <span class="badge bg-light text-dark border px-2 py-1">@Model.PaymentMethod</span>
                                <span class="badge bg-success-subtle text-success ms-1">@Model.Status</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Total Amount Due:</span>
                                <strong class="text-success fs-5">₹@Model.TotalAmount.ToString("N0")</strong>
                                <small class="text-muted d-block">(₹@Model.PackagePrice.ToString("N0") × @Model.TravelersCount + 5% GST)</small>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.SpecialRequests))
                            {
                                <div class="col-12 pt-2 border-top">
                                    <span class="text-muted d-block">Special Requests:</span>
                                    <span class="text-dark">@Model.SpecialRequests</span>
                                </div>
                            }
                        </div>
                    </div>

                    
                    <div class="text-start bg-light rounded-4 p-4 mb-4 small text-muted">
                        <h6 class="fw-bold text-dark mb-2">What Happens Next?</h6>
                        <ul class="mb-0 ps-3 d-flex flex-column gap-1">
                            <li>Your booking request is saved with pending demo-payment status.</li>
                            <li>No real payment or travel reservation has been processed by this demo.</li>
                            <li>Connect a payment provider and booking supplier before accepting real reservations.</li>
                        </ul>
                    </div>

                    
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <button onclick="window.print()" class="btn btn-outline-dark rounded-pill px-4 py-2">
                            <i class="bi bi-printer me-1"></i> Print / Save Summary
                        </button>
                        <a asp-controller="Packages" asp-action="Index" class="btn btn-outline-success rounded-pill px-4 py-2">
                            Explore More Packages
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-success rounded-pill px-4 py-2 shadow-sm">
                            ← Return to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function copyBookingId() {
        const text = document.getElementById('bookingIdText').innerText;
        navigator.clipboard.writeText(text).then(function() {
            alert('Booking Reference ID copied to clipboard: ' + text);
        });
    }
</script>
