@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="py-5" style="background: var(--cream);">
    <div class="container">
        
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" style="background: linear-gradient(135deg, var(--dark-green) 0%, #155e45 100%); color: white;">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge rounded-pill" style="background: rgba(255,255,255,0.2);">
                        <i class="bi bi-shield-lock-fill me-1"></i> Trust & Security
                    </span>
                    <small class="text-white-50">Last Updated: October 2026</small>
                </div>
                <h1 class="display-6 fw-bold mb-3" style="font-family: 'Playfair Display', serif;">Nomadic Privacy Policy</h1>
                <p class="lead mb-0 text-white-50" style="max-width: 750px;">
                    We are dedicated to safeguarding your personal information and being transparent about how we collect, handle, and protect your travel data.
                </p>
            </div>
        </div>

        <div class="row g-4">
            
            <div class="col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 90px;">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 text-uppercase small text-muted">Table of Contents</h6>
                        <ul class="nav flex-column gap-2 small">
                            <li class="nav-item">
                                <a class="nav-link p-0 text-success fw-medium" href="#introduction">1. Introduction</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link p-0 text-success fw-medium" href="#information-collected">2. Information We Collect</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link p-0 text-success fw-medium" href="#how-we-use">3. How We Use Data</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link p-0 text-success fw-medium" href="#sharing">4. Sharing with Travel Partners</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link p-0 text-success fw-medium" href="#payment-security">5. Payment & Demo Security</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link p-0 text-success fw-medium" href="#user-rights">6. Your Rights</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link p-0 text-success fw-medium" href="#contact">7. Contact Us</a>
                            </li>
                        </ul>

                        <hr class="my-4" />

                        <div class="d-grid gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success btn-sm rounded-pill">
                                <i class="bi bi-arrow-left me-1"></i> Back to Home
                            </a>
                            <a asp-controller="Packages" asp-action="Index" class="btn btn-success btn-sm rounded-pill">
                                Explore Packages
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="col-lg-9">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <section id="introduction" class="mb-5">
                        <h3 class="fw-bold text-success mb-3" style="font-family: 'Playfair Display', serif;">1. Introduction</h3>
                        <p class="text-muted leading-relaxed">
                            Welcome to <strong>Nomadic – Personalized Travel</strong> ("Nomadic", "we", "our", or "us"). We appreciate the trust you place in us when sharing your personal details to book tailor-made travel itineraries, hotel stays, tours, and flights. This Privacy Policy details our practices concerning the collection, storage, use, and disclosure of information gathered through our website and related travel services.
                        </p>
                    </section>

                    <section id="information-collected" class="mb-5">
                        <h3 class="fw-bold text-success mb-3" style="font-family: 'Playfair Display', serif;">2. Information We Collect</h3>
                        <p class="text-muted">To deliver seamless travel planning, we collect the following categories of information:</p>
                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <div class="p-3 rounded-3 bg-light h-100">
                                    <h6 class="fw-bold text-dark"><i class="bi bi-person-badge text-success me-2"></i>Personal Identification</h6>
                                    <p class="small text-muted mb-0">Full name, email address, mobile number, postal address, nationality, and date of birth required for flight and hotel ticketing.</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 rounded-3 bg-light h-100">
                                    <h6 class="fw-bold text-dark"><i class="bi bi-compass text-success me-2"></i>Travel Preferences</h6>
                                    <p class="small text-muted mb-0">Preferred destinations, travel styles (solo, family, adventure, luxury), dates, dietary preferences, and special physical requirements.</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 rounded-3 bg-light h-100">
                                    <h6 class="fw-bold text-dark"><i class="bi bi-receipt text-success me-2"></i>Booking History</h6>
                                    <p class="small text-muted mb-0">Unique Booking Reference IDs, travel dates, passenger counts, package selections, and payment method summaries.</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 rounded-3 bg-light h-100">
                                    <h6 class="fw-bold text-dark"><i class="bi bi-laptop text-success me-2"></i>Technical Device Data</h6>
                                    <p class="small text-muted mb-0">IP addresses, browser type, operating system, and anonymous cookies to optimize page responsiveness and load times.</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section id="how-we-use" class="mb-5">
                        <h3 class="fw-bold text-success mb-3" style="font-family: 'Playfair Display', serif;">3. How We Use Your Information</h3>
                        <p class="text-muted">We use your information exclusively for legitimate travel-fulfillment purposes, including:</p>
                        <ul class="text-muted small lh-lg">
                            <li>Generating personalized day-wise itineraries, vouchers, and reservation contracts.</li>
                            <li>Coordinating with certified local tour operators, hotels, airlines, and transport agencies.</li>
                            <li>Providing dynamic billing, booking confirmations, and 24/7 concierge trip updates.</li>
                            <li>Sending essential service alerts regarding itinerary changes, weather disruptions, or flight timings.</li>
                            <li>Delivering optional subscription newsletters and promotional discounts (only with your express consent).</li>
                        </ul>
                    </section>

                    <section id="sharing" class="mb-5">
                        <h3 class="fw-bold text-success mb-3" style="font-family: 'Playfair Display', serif;">4. Sharing with Travel Partners</h3>
                        <p class="text-muted">
                            To ensure your holiday operates smoothly, Nomadic shares essential passenger information only with verified third-party travel partners:
                        </p>
                        <div class="alert alert-light border p-3 rounded-3 text-muted small">
                            <i class="bi bi-info-circle-fill text-success me-2"></i>
                            <strong>We never sell your data:</strong> Nomadic does not sell, lease, or monetize your personal or contact information to advertisers, data brokers, or marketing syndicates under any circumstances.
                        </div>
                    </section>

                    <section id="payment-security" class="mb-5">
                        <h3 class="fw-bold text-success mb-3" style="font-family: 'Playfair Display', serif;">5. Payment Security & Demo Transaction Notice</h3>
                        <p class="text-muted">
                            Nomadic implements modern 256-bit SSL encryption across all digital sessions.
                        </p>
                        <div class="p-3 rounded-3 border-start border-4 border-success bg-light text-muted small">
                            <strong>Demo Payment Environment:</strong> The payment gateway on this website operates in simulated demo mode. No actual debit/credit card charges occur, and live financial credentials are neither captured nor stored in our databases.
                        </div>
                    </section>

                    <section id="user-rights" class="mb-5">
                        <h3 class="fw-bold text-success mb-3" style="font-family: 'Playfair Display', serif;">6. Your Data Rights</h3>
                        <p class="text-muted">Depending on applicable data privacy laws, you possess the right to:</p>
                        <ul class="text-muted small lh-lg">
                            <li><strong>Access:</strong> Request an export of your personal information held by Nomadic.</li>
                            <li><strong>Rectification:</strong> Correct inaccuracies or update changing contact details.</li>
                            <li><strong>Erasure:</strong> Request permanent deletion of your profile and booking archives where legally permissible.</li>
                            <li><strong>Opt-Out:</strong> Unsubscribe from marketing newsletters at any time with a single click.</li>
                        </ul>
                    </section>

                    <section id="contact" class="mb-4">
                        <h3 class="fw-bold text-success mb-3" style="font-family: 'Playfair Display', serif;">7. Contact Us</h3>
                        <p class="text-muted">If you have any questions, inquiries, or privacy concerns, please contact our team:</p>
                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <div class="border rounded-3 p-3">
                                    <small class="text-muted d-block">Privacy & Compliance Officer</small>
                                    <strong class="text-success"><i class="bi bi-envelope-at me-1"></i> privacy@nomadictravel.com</strong>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border rounded-3 p-3">
                                    <small class="text-muted d-block">Customer Care & Support</small>
                                    <strong class="text-success"><i class="bi bi-telephone me-1"></i> +91 1800-NOMADIC (Toll-Free)</strong>
                                </div>
                            </div>
                        </div>
                    </section>

                    <div class="pt-4 border-top text-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success px-4 rounded-pill me-2">
                            ← Return to Website
                        </a>
                        <a asp-controller="Home" asp-action="Terms" class="btn btn-success px-4 rounded-pill">
                            Read Terms & Conditions →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
