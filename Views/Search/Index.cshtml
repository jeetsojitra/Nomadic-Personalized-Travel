@{
    ViewData["Title"] = "Search Packages";
    var destinations = ViewBag.Destinations as IEnumerable<Nomadic.Models.Destination> ?? new List<Nomadic.Models.Destination>();
}

<div class="py-5" style="background: var(--cream);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <div class="mx-auto mb-3 rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                                <i class="bi bi-search fs-2"></i>
                            </div>
                            <h1 class="h2 fw-bold text-dark" style="font-family: 'Playfair Display', serif;">
                                Find Your Perfect Trip
                            </h1>
                            <p class="text-muted small">
                                Choose your preferences and search for your tailor-made travel package.
                            </p>
                        </div>

                        <form asp-controller="Search" asp-action="Index" method="get">
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Destination</label>
                                <select name="destination" class="form-select" required>
                                    <option value="">Select Destination</option>
                                    @if (destinations.Any())
                                    {
                                        @foreach (var d in destinations)
                                        {
                                            <option value="@d.Name" selected="@(ViewBag.Destination == d.Name)">
                                                @d.Name (@d.Location)
                                            </option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="Goa">Goa, India</option>
                                        <option value="Kashmir">Kashmir, India</option>
                                        <option value="Kerala">Kerala, India</option>
                                        <option value="Jaipur">Jaipur, India</option>
                                        <option value="Manali">Manali, India</option>
                                        <option value="Ladakh">Ladakh, India</option>
                                        <option value="Bali">Bali, Indonesia</option>
                                        <option value="Dubai">Dubai, UAE</option>
                                        <option value="Switzerland">Switzerland, Europe</option>
                                        <option value="Santorini">Santorini, Greece</option>
                                        <option value="Paris">Paris, France</option>
                                        <option value="Tokyo">Tokyo, Japan</option>
                                        <option value="Singapore">Singapore</option>
                                        <option value="Thailand">Thailand</option>
                                        <option value="Rome">Rome, Italy</option>
                                        <option value="El Nido">El Nido, Philippines</option>
                                    }
                                </select>
                            </div>

                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Travel Date</label>
                                <input type="date" name="travelDate" value="@(ViewBag.TravelDate ?? DateTime.Today.AddDays(14).ToString("yyyy-MM-dd"))" class="form-control" required />
                            </div>

                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Budget</label>
                                <select name="budget" class="form-select" required>
                                    <option value="">Select Budget</option>
                                    <option value="50000" selected="@(ViewBag.Budget == "50000")">Under ₹50,000</option>
                                    <option value="100000" selected="@(ViewBag.Budget == "100000")">₹50,000 - ₹1,00,000</option>
                                    <option value="200000" selected="@(ViewBag.Budget == "200000")">₹1,00,000 - ₹2,00,000</option>
                                    <option value="300000" selected="@(ViewBag.Budget == "300000")">Above ₹2,00,000</option>
                                </select>
                            </div>

                            
                            <div class="mb-4">
                                <label class="form-label small fw-bold text-muted">Travel Style</label>
                                <select name="travelStyle" class="form-select" required>
                                    <option value="">Select Travel Style</option>
                                    <option value="Family" selected="@(ViewBag.TravelStyle == "Family")">Family</option>
                                    <option value="Adventure" selected="@(ViewBag.TravelStyle == "Adventure")">Adventure</option>
                                    <option value="Luxury" selected="@(ViewBag.TravelStyle == "Luxury")">Luxury</option>
                                    <option value="Couple" selected="@(ViewBag.TravelStyle == "Couple")">Couple</option>
                                    <option value="Solo" selected="@(ViewBag.TravelStyle == "Solo")">Solo</option>
                                </select>
                            </div>

                            <button type="submit" class="btn btn-success w-100 rounded-pill py-3 fw-bold shadow-sm">
                                <i class="bi bi-search me-1"></i> Search Matching Packages
                            </button>
                        </form>

                        @if (ViewBag.Destination != null)
                        {
                            <div class="alert alert-success mt-4 rounded-4 p-4 border-0 shadow-sm">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <h5 class="fw-bold mb-0">Search Preferences Saved</h5>
                                </div>

                                <div class="row g-2 small mb-3">
                                    <div class="col-6">
                                        <span class="text-muted">Destination:</span> <strong>@ViewBag.Destination</strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted">Travel Date:</span> <strong>@ViewBag.TravelDate</strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted">Budget:</span> <strong>₹@ViewBag.Budget</strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted">Style:</span> <strong>@ViewBag.TravelStyle</strong>
                                    </div>
                                </div>

                                <a asp-controller="Packages"
                                   asp-action="Index"
                                   asp-route-destination="@ViewBag.Destination"
                                   class="btn btn-success rounded-pill px-4">
                                    View Matching Packages for @ViewBag.Destination <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        }

                        <div class="text-center mt-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-4">
                                ← Back to Home
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
