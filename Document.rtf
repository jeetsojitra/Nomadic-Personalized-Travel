\par
    letter-spacing: 1px;\par
\par
    margin-top: 4px;\par
\}\par
\par
\par
/* Navigation */\par
\par
.navbar-nav \{\par
    gap: 25px;\par
\}\par
\par
.nav-link \{\par
    color: #263d35 !important;\par
\par
    font-size: 14px;\par
\par
    position: relative;\par
\par
